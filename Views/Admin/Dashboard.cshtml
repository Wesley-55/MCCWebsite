@using MCCConstruction.Models

@{
    ViewData["Title"] = "Admin Dashboard";

    var contacts =
        ViewBag.Contacts as List<ContactMessage>
        ?? new List<ContactMessage>();

    var quotes =
        ViewBag.Quotes as List<QuoteRequest>
        ?? new List<QuoteRequest>();
}

<section class="admin-dashboard">

    <div class="container">

        <!-- HEADER -->
        <div class="admin-header">

            <div>
                <span class="admin-subtitle">
                    MCC CONSTRUCTION
                </span>

                <h1>
                    Admin Dashboard
                </h1>

                <p>
                    Manage enquiries and quote requests.
                </p>
            </div>

            <div>
                <form asp-controller="Admin"
                      asp-action="Logout"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-outline-danger">

                        <i class="fa-solid fa-right-from-bracket me-2"></i>

                        Logout

                    </button>

                </form>
            </div>

        </div>


        <!-- STATISTICS -->
        <div class="row g-4 mb-5">

            <div class="col-lg-3 col-md-6">

                <div class="admin-stat-card">

                    <div class="stat-icon">
                        <i class="fa-solid fa-envelope"></i>
                    </div>

                    <h2>
                        @ViewBag.ContactCount
                    </h2>

                    <p>
                        Contact Messages
                    </p>

                    <span>
                        @ViewBag.NewContactCount new
                    </span>

                </div>

            </div>


            <div class="col-lg-3 col-md-6">

                <div class="admin-stat-card">

                    <div class="stat-icon">
                        <i class="fa-solid fa-file-signature"></i>
                    </div>

                    <h2>
                        @ViewBag.QuoteCount
                    </h2>

                    <p>
                        Quote Requests
                    </p>

                    <span>
                        @ViewBag.NewQuoteCount new
                    </span>

                </div>

            </div>

        </div>


        <!-- =====================================================
             CONTACT MESSAGES
             ===================================================== -->

        <div class="admin-table-card mb-5">

            <div class="admin-table-header">

                <div>

                    <h3>
                        Contact Messages
                    </h3>

                    <p>
                        All enquiries submitted through the website.
                    </p>

                </div>

            </div>


            <div class="table-responsive admin-table-scroll">

                <table class="table align-middle admin-messages-table">

                    <thead>

                        <tr>

                            <th>Name</th>
                            <th>Company</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Subject</th>
                            <th class="message-column">Message</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th class="action-column">Action</th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (contacts.Count == 0)
                        {
                            <tr>

                                <td colspan="9"
                                    class="text-center py-4">

                                    No contact messages yet.

                                </td>

                            </tr>
                        }
                        else
                        {
                            foreach (var contact in contacts)
                            {
                                <tr>

                                    <!-- NAME -->
                                    <td>

                                        <strong>
                                            @contact.Name
                                        </strong>

                                    </td>


                                    <!-- COMPANY -->
                                    <td>

                                        @(string.IsNullOrWhiteSpace(contact.Company)
                                                                        ? "Not provided"
                                                                        : contact.Company)

                                    </td>


                                    <!-- EMAIL -->
                                    <td>

                                        <a href="mailto:@contact.Email">
                                            @contact.Email
                                        </a>

                                    </td>


                                    <!-- PHONE -->
                                    <td>

                                        @(string.IsNullOrWhiteSpace(contact.Phone)
                                                                        ? "Not provided"
                                                                        : contact.Phone)

                                    </td>


                                    <!-- SUBJECT -->
                                    <td>

                                        @(string.IsNullOrWhiteSpace(contact.Subject)
                                                                        ? "No subject"
                                                                        : contact.Subject)

                            </td>


                                                                    <!-- CUSTOMER MESSAGE -->
                                                                    <td class="message-column">

                                                                        <div class="admin-message-text">

                                                                            @contact.Message

                                                                        </div>

                                                                    </td>


                                                                    <!-- DATE -->
                                                                    <td>

                                                                        @contact.DateSent.ToString(
                                                                        "dd MMM yyyy HH:mm")

                            </td>


                                    <!-- CURRENT STATUS -->
                                    <td>

                                        <span class="status-badge">
                                            @contact.Status
                                        </span>

                                    </td>


                                    <!-- ACTION -->
                                    <td class="action-column">

                                        <div class="admin-action-wrapper">

                                            <form asp-controller="Admin"
                                                  asp-action="UpdateContactStatus"
                                                  method="post"
                                                  class="admin-action-form">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@contact.Id" />

                                                <select name="status"
                                                        class="admin-action-select"
                                                        onchange="this.form.submit()">

                                                    <option value="New"
                                                            selected="@(contact.Status == "New")">
                                                        New
                                                    </option>

                                                    <option value="Read"
                                                            selected="@(contact.Status == "Read")">
                                                        Read
                                                    </option>

                                                    <option value="Resolved"
                                                            selected="@(contact.Status == "Resolved")">
                                                        Resolved
                                                    </option>

                                                </select>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                                                }
                        }

                    </tbody>

                </table>

            </div>

        </div>


        <!-- =====================================================
             QUOTE REQUESTS
             ===================================================== -->

        <div class="admin-table-card">

            <div class="admin-table-header">

                <div>

                    <h3>
                        Quote Requests
                    </h3>

                    <p>
                        All quote requests submitted through the website.
                    </p>

                </div>

            </div>


            <div class="table-responsive admin-table-scroll">

                <table class="table align-middle admin-quotes-table">

                    <thead>

                        <tr>

                            <th>Company</th>
                            <th>Contact Person</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Project Address</th>
                            <th>Service</th>
                            <th>Budget</th>
                            <th>Start Date</th>
                            <th class="description-column">Description</th>
                            <th>Attachment</th>
                            <th>Date</th>
                            <th class="action-column">Action</th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (quotes.Count == 0)
                        {
                            <tr>

                                <td colspan="12"
                                    class="text-center py-4">

                                    No quote requests yet.

                                </td>

                            </tr>
                        }
                        else
                        {
                            foreach (var quote in quotes)
                            {
                                <tr>

                                    <!-- COMPANY -->
                                    <td>

                                        <strong>
                                            @quote.CompanyName
                                        </strong>

                                    </td>


                                    <!-- CONTACT PERSON -->
                                    <td>

                                        @quote.ContactPerson

                                    </td>


                                    <!-- EMAIL -->
                                    <td>

                                        <a href="mailto:@quote.Email">
                                            @quote.Email
                                        </a>

                                    </td>


                                    <!-- PHONE -->
                                    <td>

                                        @quote.Phone

                                    </td>


                                    <!-- PROJECT ADDRESS -->
                                    <td class="address-column">

                                        @(string.IsNullOrWhiteSpace(quote.ProjectAddress)
                                                                        ? "Not provided"
                                                                        : quote.ProjectAddress)

                                    </td>


                                    <!-- SERVICE -->
                                    <td>

                                        @(string.IsNullOrWhiteSpace(quote.ServiceRequired)
                                                                        ? "Not specified"
                                                                        : quote.ServiceRequired)

                            </td>


                                    <!-- BUDGET -->
                                    <td>

                                @if (quote.Budget.HasValue)
                                        {
                                            @quote.Budget.Value.ToString("C")
                                        }
                                        else
                                        {
                                            <span>
                                                Not specified
                                            </span>
                                        }

                                    </td>


                                    <!-- START DATE -->
                                    <td>

                                        @if (quote.ExpectedStartDate.HasValue)
                                        {
                                            @quote.ExpectedStartDate.Value.ToString(
                                            "dd MMM yyyy")
                                                                }
                                        else
                                        {
                                            <span>
                                                Not specified
                                            </span>
                                        }

                            </td>


                            <!-- DESCRIPTION -->
                            <td class="description-column">

                                <div class="admin-description-text">

                                    @(string.IsNullOrWhiteSpace(quote.Description)
                                                                        ? "No description provided."
                                                                        : quote.Description)

                                </div>

                                    </td>


                                    <!-- ATTACHMENT -->
                                    <td>

                                @if (!string.IsNullOrWhiteSpace(
                                                                quote.AttachmentPath))
                                        {
                                            <a href="@quote.AttachmentPath"
                                               target="_blank"
                                               rel="noopener noreferrer">

                                                <i class="fa-solid fa-paperclip me-1"></i>

                                                View Attachment

                                            </a>
                                        }
                                        else
                                        {
                                            <span>
                                                No attachment
                                            </span>
                                        }

                                    </td>


                                    <!-- DATE -->
                                    <td>

                                        @quote.DateSubmitted.ToString(
                                        "dd MMM yyyy HH:mm")

                            </td>


                            <!-- ACTION -->
                            <td class="action-column">

                                <div class="admin-action-wrapper">

                                    <form asp-controller="Admin"
                                          asp-action="UpdateQuoteStatus"
                                          method="post"
                                          class="admin-action-form">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@quote.Id" />

                                        <select name="status"
                                                class="admin-action-select"
                                                onchange="this.form.submit()">

                                            <option value="New"
                                                    selected="@(quote.Status == "New")">
                                                New
                                            </option>

                                            <option value="Read"
                                                    selected="@(quote.Status == "Read")">
                                                Read
                                            </option>

                                            <option value="Quoted"
                                                    selected="@(quote.Status == "Quoted")">
                                                Quoted
                                            </option>

                                            <option value="Closed"
                                                    selected="@(quote.Status == "Closed")">
                                                Closed
                                            </option>

                                        </select>

                                    </form>

                                </div>

                            </td>

                        </tr>
                                                }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</section>