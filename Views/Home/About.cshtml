@{
    ViewData["Title"] = "About Us";
}

<!-- ================= PAGE HERO ================= -->

<section class="inner-page-hero">

    <div class="container">

        <span class="section-label">
            ABOUT MCC CONSTRUCTION
        </span>

        <h1>
            Building Excellence
            <br />
            Since 1964
        </h1>

        <p>
            More than six decades of construction,
            civil engineering and infrastructure experience.
        </p>

    </div>

</section>


<!-- ================= INTRODUCTION ================= -->

<section class="about-main-section py-5">

    <div class="container">

        <div class="row align-items-center g-5">

            <div class="col-lg-6">

                <div class="about-main-image">

                    <img src="~/images/about/about.jpg"
                         alt="MCC Construction"
                         class="img-fluid">

                </div>

            </div>


            <div class="col-lg-6">

                <span class="section-label">
                    WHO WE ARE
                </span>

                <h2 class="section-title">

                    A Legacy Built
                    <span>On Experience</span>

                </h2>

                <p>

                    Melmoth Cartage & Cement Products Pty Ltd,
                    trading as MCC Construction, was established
                    in 1964 and has grown into an established
                    construction and infrastructure business
                    operating across KwaZulu-Natal.

                </p>

                <p>

                    Originally founded as a fertilizer transport
                    business in Melmoth, the company expanded
                    into bulk transport, earthworks, road building,
                    civil engineering and large-scale construction.

                </p>

                <p>

                    Today, MCC Construction operates from
                    Ballito, Howick and Melmoth, delivering
                    projects across residential, commercial,
                    public-use and civil infrastructure sectors.

                </p>

            </div>

        </div>

    </div>

</section>


<!-- ================= HISTORY ================= -->

<section class="history-section">

    <div class="container">

        <div class="section-heading text-center">

            <span class="section-label">
                OUR HISTORY
            </span>

            <h2 class="section-title">
                Six Decades of Growth
            </h2>

            <p>

                From transport to construction and civil
                engineering, MCC has continued to evolve
                alongside the needs of the industry.

            </p>

        </div>


        <div class="timeline">

            <!-- 1964 -->

            <div class="timeline-item">

                <div class="timeline-year">
                    1964
                </div>

                <div class="timeline-content">

                    <h3>
                        The Beginning
                    </h3>

                    <p>

                        MCC was established in Melmoth,
                        originally operating as a fertilizer
                        transport business.

                    </p>

                </div>

            </div>


            <!-- LATE 1960s -->

            <div class="timeline-item">

                <div class="timeline-year">
                    Late 1960s
                </div>

                <div class="timeline-content">

                    <h3>
                        Expansion of Transport
                    </h3>

                    <p>

                        The company expanded its transport
                        operations to include sand, crushed
                        stone, timber and general goods
                        throughout KwaZulu-Natal.

                    </p>

                </div>

            </div>


            <!-- 1973 -->

            <div class="timeline-item">

                <div class="timeline-year">
                    1973
                </div>

                <div class="timeline-content">

                    <h3>
                        Entering Earthworks
                    </h3>

                    <p>

                        Investment in mechanical loading
                        equipment allowed MCC to move into
                        earthworks, road building and
                        land clearing.

                    </p>

                </div>

            </div>


            <!-- MID 1970s -->

            <div class="timeline-item">

                <div class="timeline-year">
                    Mid-1970s
                </div>

                <div class="timeline-content">

                    <h3>
                        Construction Growth
                    </h3>

                    <p>

                        MCC expanded its equipment fleet
                        with bulldozers, scrapers, rollers,
                        concrete mixers and graders.

                        The company completed more than
                        20 earth dams in the Melmoth region.

                    </p>

                </div>

            </div>


            <!-- MCP -->

            <div class="timeline-item">

                <div class="timeline-year">
                    Late 1970s
                </div>

                <div class="timeline-content">

                    <h3>
                        Melmoth Cement Products
                    </h3>

                    <p>

                        Melmoth Cement Products was established
                        to manufacture cement bricks, blocks,
                        kerbing and pavers for internal projects
                        and the public.

                    </p>

                </div>

            </div>


            <!-- TODAY -->

            <div class="timeline-item">

                <div class="timeline-year">
                    Today
                </div>

                <div class="timeline-content">

                    <h3>
                        MCC Construction
                    </h3>

                    <p>

                        MCC continues to deliver construction,
                        civil engineering and infrastructure
                        projects across KwaZulu-Natal.

                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- ================= COMMITMENT ================= -->

<section class="commitment-section">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-6">

                <span class="section-label">
                    OUR COMMITMENT
                </span>

                <h2 class="section-title text-white">

                    Building People,
                    <span>Projects & Communities</span>

                </h2>

                <p class="commitment-text">

                    MCC Construction believes that successful
                    construction is about more than completing
                    a project. It is about creating opportunities,
                    developing people and building relationships
                    that last.

                </p>

                <p class="commitment-text">

                    We remain committed to quality workmanship,
                    skills development, mentorship, safety and
                    meaningful participation from the communities
                    in which we operate.

                </p>

            </div>


            <div class="col-lg-6">

                <div class="commitment-grid">

                    <div class="commitment-card">

                        <i class="fa-solid fa-users"></i>

                        <h4>
                            Local Employment
                        </h4>

                        <p>
                            Creating opportunities within
                            local communities.
                        </p>

                    </div>


                    <div class="commitment-card">

                        <i class="fa-solid fa-graduation-cap"></i>

                        <h4>
                            Skills Development
                        </h4>

                        <p>
                            Training and developing industry
                            skills for the future.
                        </p>

                    </div>


                    <div class="commitment-card">

                        <i class="fa-solid fa-shield-halved"></i>

                        <h4>
                            Safety
                        </h4>

                        <p>
                            Maintaining a safe and controlled
                            working environment.
                        </p>

                    </div>


                    <div class="commitment-card">

                        <i class="fa-solid fa-award"></i>

                        <h4>
                            Quality
                        </h4>

                        <p>
                            Delivering high-quality workmanship
                            on every project.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


