<!-- ================= CTA ================= -->

<section class="quote-cta">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-8">

                <span>
                    READY TO START?
                </span>

                <h2>
                    Let's Build Your Next Project.
                </h2>

                <p>
                    Contact MCC Construction to discuss
                    your requirements.
                </p>

            </div>

