<!-- =========================================================
     MCC PROJECT MILESTONE
     ========================================================= -->

<section class="projects-why-mcc">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-7">

                <span class="projects-section-label">
                    MCC CONSTRUCTION
                </span>

                <h2>
                    Nearly <span>R1 Billion</span>
                    in Completed Projects.
                </h2>

                <p>
                    MCC Construction continues to build not just
                    infrastructure, but a legacy of excellence.
                </p>

            </div>


            <div class="col-lg-5">

                <div class="why-mcc-grid">

                    <div class="why-mcc-item">

                        <i class="fa-solid fa-award"></i>

                        <div>

                            <h4>
                                Quality
                            </h4>

                            <p>
                                High-quality workmanship across
                                every project.
                            </p>

                        </div>

                    </div>


                    <div class="why-mcc-item">

                        <i class="fa-solid fa-shield-halved"></i>

                        <div>

                            <h4>
                                Safety
                            </h4>

                            <p>
                                A safe and controlled working
                                environment.
                            </p>

                        </div>

                    </div>


                    <div class="why-mcc-item">

                        <i class="fa-solid fa-users"></i>

                        <div>

                            <h4>
                                Experience
                            </h4>

                            <p>
                                More than 60 years of company
                                history.
                            </p>

                        </div>

                    </div>


                    <div class="why-mcc-item">

                        <i class="fa-solid fa-handshake"></i>

                        <div>

                            <h4>
                                Relationships
                            </h4>

                            <p>
                                Building relationships that
                                stand the test of time.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     CTA
     ========================================================= -->

<section class="projects-final-cta">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-8">

                <span>
                    HAVE A PROJECT IN MIND?
                </span>

                <h2>
                    Let's Build Something
                    <strong>Exceptional.</strong>
                </h2>

                <p>
                    Talk to MCC Construction about your next
                    construction or development project.
                </p>

            </div>


            <div class="col-lg-4 text-lg-end">

                <a asp-controller="Quote"
                   asp-action="Index"
                   class="btn btn-warning btn-lg">

                    Request a Quote

                    <i class="fa-solid fa-arrow-right ms-2"></i>

                </a>

            </div>

        </div>

    </div>

</section>