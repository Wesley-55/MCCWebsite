@{
    ViewData["Title"] = "Projects";
}

<!-- =========================================================
     PROJECT HERO
     ========================================================= -->

<section class="projects-hero">

    <div class="projects-hero-overlay">

        <div class="container">

            <div class="row">

                <div class="col-lg-8">

                    <span class="projects-eyebrow">
                        MCC CONSTRUCTION
                    </span>

                    <h1>
                        Our
                        <span>Projects.</span>
                    </h1>

                    <p>
                        Explore selected projects delivered by MCC Construction
                        across public, commercial and residential sectors.
                    </p>

                    <div class="projects-hero-buttons">

                        <a asp-controller="Quote"
                           asp-action="Index"
                           class="btn btn-warning btn-lg">

                            Request a Quote

                            <i class="fa-solid fa-arrow-right ms-2"></i>

                        </a>

                        <a href="#project-portfolio"
                           class="btn btn-outline-light btn-lg">

                            View Our Projects

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     PROJECT STATS
     ========================================================= -->

<section class="project-stats">

    <div class="container">

        <div class="row g-0">

            <div class="col-lg-3 col-md-6">

                <div class="project-stat">

                    <i class="fa-solid fa-calendar-days"></i>

                    <strong>1964</strong>

                    <span>Established</span>

                </div>

            </div>


            <div class="col-lg-3 col-md-6">

                <div class="project-stat">

                    <i class="fa-solid fa-building"></i>

                    <strong>5</strong>

                    <span>Featured Projects</span>

                </div>

            </div>


            <div class="col-lg-3 col-md-6">

                <div class="project-stat">

                    <i class="fa-solid fa-chart-line"></i>

                    <strong>R1B+</strong>

                    <span>Completed Project Value</span>

                </div>

            </div>


            <div class="col-lg-3 col-md-6">

                <div class="project-stat">

                    <i class="fa-solid fa-award"></i>

                    <strong>Level 9</strong>

                    <span>CIDB GB</span>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     INTRODUCTION
     ========================================================= -->

<section class="projects-introduction">

    <div class="container">

        <div class="row align-items-end">

            <div class="col-lg-7">

                <span class="projects-section-label">
                    OUR PROJECTS
                </span>

                <h2>
                    Building Across
                    <span>KwaZulu-Natal.</span>
                </h2>

            </div>

            <div class="col-lg-5">

                <p>
                    MCC Construction has delivered projects across
                    public, commercial, residential and infrastructure
                    sectors, with nearly R1 billion in completed projects.
                </p>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     FEATURED PROJECT
     ========================================================= -->

<section class="featured-project">

    <div class="container">

        <div class="featured-project-wrapper">

            <div class="row g-0 align-items-stretch">

                <div class="col-lg-7">

                    <div class="featured-project-image">

                        <img src="~/Images/projects/project1.jpg"
                             alt="University of Zululand Engineering Building">

                        <div class="featured-label">
                            FEATURED PROJECT
                        </div>

                    </div>

                </div>


                <div class="col-lg-5">

                    <div class="featured-project-content">

                        <span>
                            PUBLIC USE DEVELOPMENT
                        </span>

                        <h2>
                            University of Zululand
                        </h2>

                        <h3>
                            Engineering Building
                        </h3>

                        <p>
                            University of Zululand Engineering Building,
                            one of the landmark public-use developments
                            featured by MCC Construction.
                        </p>

                        <div class="featured-details">

                            <div>

                                <i class="fa-solid fa-location-dot"></i>

                                <div>

                                    <small>Region</small>

                                    <strong>
                                        KwaZulu-Natal
                                    </strong>

                                </div>

                            </div>


                            <div>

                                <i class="fa-solid fa-building"></i>

                                <div>

                                    <small>Sector</small>

                                    <strong>
                                        Public Use Development
                                    </strong>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


