@{
    ViewData["Title"] = "Gallery";
}

<!-- ==========================================
     GALLERY HERO
     ========================================== -->

<section class="gallery-hero">

    <div class="container">

        <div class="gallery-hero-content">

            <span>MCC CONSTRUCTION</span>

            <h1>
                Our <strong>Gallery</strong>
            </h1>

            <p>
                Explore selected projects and construction
                work delivered by MCC Construction.
            </p>

        </div>

    </div>

</section>


<!-- ==========================================
     PROJECT GALLERY
     ========================================== -->

<section class="gallery-section">

    <div class="container">

        <div class="text-center mb-5">

            <span class="gallery-label">
                OUR WORK
            </span>

            <h2>
                Project <span>Gallery</span>
            </h2>

            <p>
                A selection of MCC Construction projects.
            </p>

        </div>


        <div class="row g-4">

            <!-- PROJECT 1 -->

            <div class="col-lg-4 col-md-6">

                <div class="gallery-card">

                    <img src="~/Images/projects/project1.jpg"
                         alt="University of Zululand Engineering Building">

                </div>

            </div>


            <!-- PROJECT 2 -->

            <div class="col-lg-4 col-md-6">

                <div class="gallery-card">

                    <img src="~/Images/projects/project2.jpg"
                         alt="Catherine Booth Hospital">

                </div>

            </div>


            <!-- PROJECT 3 -->

            <div class="col-lg-4 col-md-6">

                <div class="gallery-card">

                    <img src="~/Images/projects/project3.jpg"
                         alt="University of Zululand Student Accommodation">

                </div>

            </div>


            <!-- PROJECT 4 -->

            <div class="col-lg-4 col-md-6">

                <div class="gallery-card">

                    <img src="~/Images/projects/project4.jpg"
                         alt="Durban University of Technology">

                </div>

            </div>


            <!-- PROJECT 5 -->

            <div class="col-lg-4 col-md-6">

                <div class="gallery-card">

                    <img src="~/Images/projects/project5.jpg"
                         alt="Amber Glades Retirement Home">

                </div>

            </div>


            <!-- PROJECT 6 -->

            <div class="col-lg-4 col-md-6">

                <div class="gallery-card">

                    <img src="~/Images/projects/project6.jpg"
                         alt="MCC Construction Project">

                </div>

            </div>

        </div>

    </div>

</section>


<!-- ==========================================
     LOCATION
     ========================================== -->

<section class="location-section">

    <div class="container">

        <div class="text-center mb-5">

            <span class="gallery-label">
                FIND US
            </span>

            <h2>
                Our <span>Location</span>
            </h2>

            <p>
                Visit the MCC Construction Durban Head Office.
            </p>

        </div>


        <div class="row g-4 align-items-stretch">


            <!-- ==================================
                 ADDRESS / CONTACT
                 ================================== -->

            <div class="col-lg-5">

                <div class="location-info">

                    <div class="location-icon">

                        <i class="fa-solid fa-location-dot"></i>

                    </div>


                    <h2>
                        Durban — <span>Head Office</span>
                    </h2>


                    <p class="location-intro">

                        MCC Construction's Durban Head Office
                        is located in Glen Ashley, Durban North.

                    </p>


                    <!-- ADDRESS -->

                    <div class="location-detail">

                        <div class="location-detail-icon">

                            <i class="fa-solid fa-location-dot"></i>

                        </div>

                        <div>

                            <h5>
                                Address
                            </h5>

                            <p>

                                56 Newport Avenue<br />
                                Glen Ashley<br />
                                Durban North<br />
                                4051

                            </p>

                        </div>

                    </div>


                    <!-- TELEPHONE -->

                    <div class="location-detail">

                        <div class="location-detail-icon">

                            <i class="fa-solid fa-phone"></i>

                        </div>

                        <div>

                            <h5>
                                Telephone
                            </h5>

                            <p>

                                <a href="tel:0827846790">
                                    082 784 6790
                                </a>

                            </p>

                        </div>

                    </div>


                    <!-- CELL -->

                    <div class="location-detail">

                        <div class="location-detail-icon">

                            <i class="fa-solid fa-mobile-screen-button"></i>

                        </div>

                        <div>

                            <h5>
                                Cell
                            </h5>

                            <p>

                                <a href="tel:0828196522">
                                    082 819 6522
                                </a>

                            </p>

                        </div>

                    </div>


                    <!-- GOOGLE MAPS BUTTON -->

                    <a href="https://www.google.com/maps/dir/?api=1&destination=56+Newport+Ave%2C+Glenashley%2C+Durban+North%2C+4051"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="location-button">

                        <i class="fa-solid fa-location-arrow me-2"></i>

                        Open in Google Maps

                    </a>

                </div>

            </div>


            <!-- ==================================
                 GOOGLE MAP
                 ================================== -->

            <div class="col-lg-7">

                <div style="
        width: 100%;
        height: 500px;
        overflow: hidden;
        border-radius: 12px;
        background: #dddddd;
    ">

                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3134.3950137482157!2d31.055743099999997!3d-29.759731000000006!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x1ef7066d28ba80dd%3A0x285e8909c2832cdc!2s56%20Newport%20Ave%2C%20Glenashley%2C%20Durban%20North%2C%204051!5e1!3m2!1sen!2sza!4v1789556625183!5m2!1sen!2sza"
                            width="100%"
                            height="500"
                            style="border:0; display:block;"
                            allowfullscreen
                            loading="eager"
                            referrerpolicy="strict-origin-when-cross-origin">
                    </iframe>

                </div>

            </div>

    </div>

</section>


<!-- ==========================================
     CALL TO ACTION
     ========================================== -->

<section class="gallery-cta">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-8">

                <span>
                    HAVE A PROJECT IN MIND?
                </span>

                <h2>

                    Let's Build Something
                    <strong>Exceptional.</strong>

                </h2>

            </div>


            <div class="col-lg-4 text-lg-end">

                <a asp-controller="Quote"
                   asp-action="Index"
                   class="btn btn-warning btn-lg">

                    Request a Quote

                    <i class="fa-solid fa-arrow-right ms-2"></i>

                </a>

            </div>

        </div>

    </div>

</section>